# Root environment reference for local development.
# Individual apps also have their own .env.example (apps/api, apps/web).

DATABASE_URL=postgres://arf:arf@localhost:5432/arf_os
REDIS_URL=redis://localhost:6379

# Clerk (auth) — required for Milestone 4
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# S3-compatible object storage (e.g. Cloudflare R2) — required for Milestone 7
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_REGION=auto

# Model provider — required for Milestone 12 (agent-runtime IDEA_SCOUT path)
MODEL_PROVIDER_API_KEY=
