{
  "name": "@arf-os/worker-forward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@arf-os/contracts": "workspace:*",
    "@arf-os/db": "workspace:*",
    "@arf-os/event-bus": "workspace:*",
    "@arf-os/metrics": "workspace:*",
    "@arf-os/observability": "workspace:*",
    "bullmq": "^5.34.1",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
