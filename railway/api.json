{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm exec turbo run build --filter=@arf-os/api...",
    "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", "package.json", "turbo.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @arf-os/db db:migrate",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
